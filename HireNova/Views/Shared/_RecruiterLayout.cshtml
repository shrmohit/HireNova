
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var recruiterName = Context.Session.GetString("RecruiterName") ?? "Recruiter";
    var initial = recruiterName.Length > 0
        ? recruiterName.Substring(0, 1).ToUpper()
        : "R";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - HireNova</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <style>
        :root {
            --primary: #052b68;
            --primary-light: #0b438f;
            --accent: #990000;
            --accent-hover: #7d0000;
            --sidebar: #101827;
            --page-bg: #f4f6f9;
            --border: #e2e8f0;
            --muted: #64748b;
            --text: #172033;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            margin: 0;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: var(--page-bg);
            color: var(--text);
            overflow: hidden;
        }

        a {
            text-decoration: none;
        }

        /* SIDEBAR */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 260px;
            background: var(--sidebar);
            color: #fff;
            z-index: 1050;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .brand {
            height: 78px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 22px;
            border-bottom: 1px solid rgba(255,255,255,.09);
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent);
            color: #fff;
            border-radius: 10px;
            font-size: 22px;
            font-weight: 800;
        }

        .brand-name {
            font-size: 22px;
            font-weight: 800;
            color: #fff;
        }

        .brand-name span {
            color: #f87171;
        }

        .menu-heading {
            padding: 24px 22px 10px;
            color: #94a3b8;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.3px;
        }

        .menu {
            padding: 0 12px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px 14px;
            margin-bottom: 5px;
            border-radius: 8px;
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 600;
            transition: background .2s ease;
        }

        .menu-link:hover {
            color: #fff;
            background: rgba(255,255,255,.08);
        }

        .menu-link.active {
            color: #fff;
            background: var(--accent);
            box-shadow: 0 5px 14px rgba(153,0,0,.25);
        }

        .menu-icon {
            width: 22px;
            flex-shrink: 0;
            text-align: center;
            font-size: 17px;
        }

        .sidebar-bottom {
            margin: 25px 12px 16px;
            padding: 16px;
            border-radius: 10px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
        }

        .sidebar-bottom-title {
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .sidebar-bottom-text {
            color: #94a3b8;
            font-size: 11px;
            line-height: 1.6;
            margin-bottom: 0;
        }

        /* MAIN CONTENT: only this area scrolls */
        .main {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            left: 260px;
            padding: 0 28px 24px;
            overflow-y: auto;
            overflow-x: hidden;
            background: var(--page-bg);
        }

        /* TOP BAR */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 100;
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            background: var(--page-bg);
            border-bottom: 1px solid var(--border);
            margin-bottom: 25px;
        }

        .topbar-title {
            margin: 0;
            color: var(--primary);
            font-size: 22px;
            font-weight: 800;
        }

        .topbar-subtitle {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 12px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-date {
            color: var(--muted);
            font-size: 12px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: 15px;
            border-left: 1px solid var(--border);
        }

        .profile-avatar {
            width: 39px;
            height: 39px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary);
            color: #fff;
            border-radius: 50%;
            font-size: 15px;
            font-weight: 800;
        }

        .profile-name {
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
        }

        .profile-role {
            color: var(--muted);
            font-size: 11px;
        }

        /* COMMON COMPONENTS */
        .page-heading {
            color: var(--primary);
            font-size: 24px;
            font-weight: 800;
        }

        .page-description {
            color: var(--muted);
            font-size: 13px;
        }

        .btn-hirenova {
            background: var(--accent);
            color: #fff;
            border: 1px solid var(--accent);
            border-radius: 7px;
            padding: 10px 16px;
            font-size: 12px;
            font-weight: 700;
        }

        .btn-hirenova:hover {
            background: var(--accent-hover);
            color: #fff;
            border-color: var(--accent-hover);
        }

        .content-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(15,23,42,.035);
        }

        .content-card-header {
            padding: 17px 20px;
            border-bottom: 1px solid var(--border);
        }

        .content-card-title {
            color: var(--primary);
            font-size: 15px;
            font-weight: 800;
            margin: 0;
        }

        .content-card-body {
            padding: 20px;
        }

        .table thead th {
            background: #eef3fa;
            color: var(--primary);
            border-bottom: 1px solid var(--border);
            font-size: 11px;
            font-weight: 800;
            padding: 14px;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 14px;
            font-size: 12px;
            vertical-align: middle;
            color: #334155;
        }

        .table tbody tr:hover td {
            background: #fff8f8;
        }

        /* FOOTER */
        .page-footer {
            padding: 20px 0 5px;
            margin-top: 25px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: var(--muted);
            font-size: 11px;
        }

        /* RESPONSIVE: Razor .cshtml requires @@media */
        @@media (max-width: 1000px) {
            .sidebar {
                width: 220px;
            }

            .main {
                left: 220px;
                padding-left: 20px;
                padding-right: 20px;
            }

            .topbar-title {
                font-size: 19px;
            }
        }

        @@media (max-width: 650px) {
            .sidebar {
                width: 66px;
            }

            .brand {
                justify-content: center;
                padding: 0;
            }

            .brand-name,
            .menu-heading,
            .menu-text,
            .sidebar-bottom,
            .profile-details {
                display: none;
            }

            .menu {
                padding: 0 8px;
            }

            .menu-link {
                justify-content: center;
                padding: 13px 5px;
            }

            .menu-icon {
                font-size: 19px;
            }

            .main {
                left: 66px;
                padding-left: 13px;
                padding-right: 13px;
            }

            .topbar {
                min-height: 70px;
                margin-bottom: 18px;
            }

            .topbar-title {
                font-size: 17px;
            }

            .topbar-subtitle,
            .topbar-date {
                display: none;
            }

            .profile {
                padding-left: 8px;
            }

            .profile-avatar {
                width: 34px;
                height: 34px;
            }

            .page-heading {
                font-size: 20px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <aside class="sidebar">
        <a asp-controller="Recruiter"
           asp-action="Dashboard"
           class="brand">
            <div class="brand-icon">H</div>
            <div class="brand-name">Hire<span>Nova</span></div>
        </a>

        <div class="menu-heading">RECRUITER WORKSPACE</div>

        <nav class="menu">
            <a asp-controller="Recruiter" asp-action="Dashboard"
               class="menu-link @(currentAction == "Dashboard" ? "active" : "")"
               title="Dashboard">
                <span class="menu-icon">▦</span>
                <span class="menu-text">Dashboard</span>
            </a>

            <a asp-controller="Recruiter" asp-action="CompanyProfile"
               class="menu-link @(currentAction == "CompanyProfile" ? "active" : "")"
               title="Company Profile">
                <span class="menu-icon">▤</span>
                <span class="menu-text">Company Profile</span>
            </a>

            <a asp-controller="Recruiter" asp-action="ManageJobs"
               class="menu-link @(currentAction == "ManageJobs" ? "active" : "")"
               title="Manage Jobs">
                <span class="menu-icon">▣</span>
                <span class="menu-text">Manage Jobs</span>
            </a>

            <a asp-controller="Recruiter" asp-action="Applications"
               class="menu-link @(currentAction == "Applications" ? "active" : "")"
               title="Applications">
                <span class="menu-icon">☷</span>
                <span class="menu-text">Applications</span>
            </a>

            <a asp-controller="Recruiter" asp-action="Interviews"
               class="menu-link @(currentAction == "Interviews" ? "active" : "")"
               title="Interviews">
                <span class="menu-icon">◷</span>
                <span class="menu-text">Interviews</span>
            </a>

            <a asp-controller="Recruiter" asp-action="Notifications"
               class="menu-link @(currentAction == "Notifications" ? "active" : "")"
               title="Notifications">
                <span class="menu-icon">♧</span>
                <span class="menu-text">Notifications</span>
            </a>

            <a asp-controller="Recruiter" asp-action="HiringReports"
               class="menu-link @(currentAction == "HiringReports" ? "active" : "")"
               title="Hiring Reports">
                <span class="menu-icon">▥</span>
                <span class="menu-text">Hiring Reports</span>
            </a>
        </nav>

        <div class="menu-heading">ACCOUNT</div>

        <nav class="menu">
            <a asp-controller="Recruiter" asp-action="Logout"
               class="menu-link" title="Logout">
                <span class="menu-icon">⇥</span>
                <span class="menu-text">Logout</span>
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-bottom-title">HireNova Recruiter</div>
            <p class="sidebar-bottom-text">
                Manage jobs, candidates and interviews from one workspace.
            </p>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div>
                <h1 class="topbar-title">
                    @(ViewData["Title"] ?? "Recruiter Workspace")
                </h1>
                <p class="topbar-subtitle">
                    Manage your hiring activities from one place.
                </p>
            </div>

            <div class="topbar-right">
                <span class="topbar-date">
                    @DateTime.Now.ToString("dd MMM yyyy")
                </span>

                <div class="profile">
                    <div class="profile-avatar">@initial</div>
                    <div class="profile-details">
                        <div class="profile-name">@recruiterName</div>
                        <div class="profile-role">Recruiter</div>
                    </div>
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="page-footer">
            <span>© @DateTime.Now.Year HireNova. All rights reserved.</span>
            <span>Recruiter Workspace</span>
        </footer>
    </main>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

