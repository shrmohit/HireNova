@model HireNova.Data_Model.DTOs.AdminLoginDTO

@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HireNova | Admin Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #eaf2ff, #f8fbff);
            }

            .login-card {
                max-width: 1120px;
                min-height: 610px;
                border-radius: 16px;
                overflow: hidden;
            }

            .brand-panel {
                background: linear-gradient(145deg, #062e70, #0755c5 65%, #087cf5);
                color: white;
                min-height: 610px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: white;
                color: #0875ed;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
                font-weight: 800;
            }

            .hero-heading {
                font-size: 2rem;
                font-weight: 700;
                line-height: 1.3;
            }

            .hero-description {
                color: #d4e5ff;
                max-width: 300px;
                font-size: .9rem;
                line-height: 1.8;
            }

            .hero-art {
                min-height: 245px;
                background: radial-gradient(ellipse at center, rgba(50, 159, 255, .45), transparent 70%);
            }

            .art-window {
                width: 85px;
                height: 65px;
                background: rgba(112, 192, 255, .7);
                border: 1px solid rgba(255,255,255,.25);
                border-radius: 10px;
            }

            .art-person {
                width: 95px;
                height: 115px;
                position: relative;
            }

            .art-head {
                width: 30px;
                height: 35px;
                position: absolute;
                top: 0;
                left: 33px;
                border-radius: 45%;
                background: #ffb9a6;
            }

            .art-hair {
                position: absolute;
                top: -3px;
                left: 0;
                width: 30px;
                height: 12px;
                border-radius: 50% 50% 20% 20%;
                background: #132746;
            }

            .art-body {
                position: absolute;
                top: 33px;
                left: 17px;
                width: 57px;
                height: 62px;
                border-radius: 18px 18px 5px 5px;
                background: #16a2ff;
            }

            .art-laptop {
                position: absolute;
                top: 65px;
                left: 35px;
                width: 72px;
                height: 48px;
                border: 4px solid #102a49;
                border-radius: 5px;
                background: #071b35;
                transform: skewY(-7deg);
            }

            .plant {
                font-size: 45px;
                align-self: end;
            }

            .stat-value {
                font-weight: 700;
                font-size: .95rem;
            }

            .stat-label {
                font-size: .75rem;
                color: #d4e5ff;
            }

            .form-control {
                min-height: 44px;
                border-color: #d9e3f0;
                border-radius: 7px;
                font-size: .9rem;
            }

                .form-control:focus {
                    border-color: #1681f8;
                    box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
                }

            .btn-login {
                min-height: 44px;
                border-radius: 7px;
                background: #0875ed;
                border-color: #0875ed;
                font-weight: 600;
            }

                .btn-login:hover {
                    background: #075dc0;
                    border-color: #075dc0;
                }

            .auth-tabs .btn {
                font-size: .85rem;
            }

            .social-btn {
                min-height: 42px;
                border-color: #dce5ef;
                background: white;
            }

                .social-btn:hover {
                    background: #f1f6ff;
                }

            .login-footer {
                color: #73839a;
                font-size: .8rem;
            }

            @@media (max-width: 767.98px) {
                .brand-panel {
                    min-height: auto;
                }

                .hero-art {
                    min-height: 170px;
                }

                .hero-heading {
                    font-size: 1.65rem;
                }
            }
    </style>
</head>

<body>

    <main class="container-fluid min-vh-100 d-flex flex-column
        justify-content-center align-items-center p-3">

        <div class="card login-card border-0 shadow-lg w-100">

            <div class="row g-0 h-100">

                <!-- LEFT BRAND PANEL -->
                <section class="col-md-6 col-lg-6 brand-panel
                    d-flex flex-column p-4 p-lg-5">

                    <div class="d-flex align-items-center gap-2 mb-4">
                        <div class="brand-icon">H</div>
                        <span class="fs-4 fw-bold">HireNova</span>
                    </div>

                    <div class="mt-2">
                        <h1 class="hero-heading mb-3">
                            Find Your Dream Job<br />
                            Build Your Future
                        </h1>

                        <p class="hero-description mb-0">
                            Connecting talented people with leading companies.
                            Your next opportunity is just a click away.
                        </p>
                    </div>

                    <!-- Bootstrap-based illustration -->
                    <div class="hero-art d-flex align-items-center
                        justify-content-around">

                        <div class="plant">🪴</div>

                        <div class="position-relative d-flex
                            align-items-end justify-content-center"
                             style="min-width:150px;height:150px">

                            <div class="art-window position-absolute top-0 start-0">
                            </div>

                            <div class="art-window position-absolute top-0 end-0"
                                 style="width:45px;height:80px">
                            </div>

                            <div class="art-person">
                                <div class="art-head">
                                    <div class="art-hair"></div>
                                </div>
                                <div class="art-body"></div>
                                <div class="art-laptop"></div>
                            </div>

                        </div>

                        <div class="plant">🌿</div>
                    </div>

                    <div class="row g-2 pt-4 mt-auto border-top
                        border-light border-opacity-25">

                        <div class="col-4">
                            <div class="stat-value">♙ 50k+</div>
                            <div class="stat-label mt-1">Active Jobs</div>
                        </div>

                        <div class="col-4">
                            <div class="stat-value">▦ 20k+</div>
                            <div class="stat-label mt-1">Companies</div>
                        </div>

                        <div class="col-4">
                            <div class="stat-value">♧ 1M+</div>
                            <div class="stat-label mt-1">Happy Users</div>
                        </div>

                    </div>
                </section>

                <!-- RIGHT LOGIN PANEL -->
                <section class="col-md-6 col-lg-6 bg-white
                    d-flex align-items-center justify-content-center
                    p-4 p-lg-5">

                    <div class="w-100" style="max-width:410px">

                        <div class="mb-4">
                            <h2 class="h4 fw-bold mb-1 text-dark">
                                Welcome Back 👋
                            </h2>
                            <p class="text-secondary small mb-0">
                                Sign in to your HireNova account
                            </p>
                        </div>

                        <div class="btn-group w-100 auth-tabs mb-4"
                             role="group" aria-label="Authentication">

                            <button type="button"
                                    class="btn btn-primary active">
                                Login
                            </button>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled>
                                Register
                            </button>
                        </div>

                        <form asp-controller="Admin"
                              asp-action="Login"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger small mb-3">
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email"
                                       class="form-label small fw-semibold">
                                    Admin Email
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="Enter your email"
                                       autocomplete="username" />

                                <span asp-validation-for="Email"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password"
                                       class="form-label small fw-semibold">
                                    Password
                                </label>

                                <div class="input-group">
                                    <input asp-for="Password"
                                           type="password"
                                           id="adminPassword"
                                           class="form-control"
                                           placeholder="Enter your password"
                                           autocomplete="current-password" />

                                    <button type="button"
                                            id="togglePassword"
                                            class="btn btn-outline-secondary"
                                            aria-label="Show password">
                                        👁
                                    </button>
                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="d-flex justify-content-between
                                align-items-center gap-2 mb-4 small">

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="rememberMe" />

                                    <label class="form-check-label text-secondary"
                                           for="rememberMe">
                                        Remember me
                                    </label>
                                </div>

                                <a asp-controller="Admin"
                                   asp-action="ForgotPassword"
                                   class="text-decoration-none">
                                    Forgot Password?
                                </a>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary btn-login w-100">
                                Login
                            </button>

                        </form>

                        <div class="mt-4">

                            <div class="d-flex align-items-center gap-3
                                text-secondary small mb-3">
                                <hr class="flex-grow-1 my-0" />
                                <span class="text-nowrap">Or continue with</span>
                                <hr class="flex-grow-1 my-0" />
                            </div>

                            <div class="row g-2">
                                <div class="col-4">
                                    <button type="button"
                                            class="btn social-btn w-100"
                                            aria-label="Google login">
                                        <span class="fw-bold text-danger">G</span>
                                    </button>
                                </div>

                                <div class="col-4">
                                    <button type="button"
                                            class="btn social-btn w-100"
                                            aria-label="GitHub login">
                                        <span class="fw-bold">GH</span>
                                    </button>
                                </div>

                                <div class="col-4">
                                    <button type="button"
                                            class="btn social-btn w-100"
                                            aria-label="LinkedIn login">
                                        <span class="fw-bold text-primary">in</span>
                                    </button>
                                </div>
                            </div>

                            <p class="text-center text-secondary small mt-4 mb-0">
                                Don't have an account?
                                <a asp-controller="Admin" asp-action="Register"
                                   class="text-decoration-none">
                                    Register here
                                </a>
                            </p>

                        </div>

                    </div>
                </section>

            </div>
        </div>

        <footer class="login-footer text-center mt-3">
            &copy; @DateTime.Now.Year HireNova. All rights reserved.
        </footer>

    </main>

    <script>
            (function() {
                const password = document.getElementById("adminPassword");
                const toggle = document.getElementById("togglePassword");

                if (password && toggle) {
                    toggle.addEventListener("click", function() {
                        const isHidden = password.type === "password";
                        password.type = isHidden ? "text" : "password";
                        toggle.setAttribute(
                            "aria-label",
                            isHidden ? "Hide password" : "Show password"
                        );
                    });
                }
            })();
    </script>

</body>
</html>
